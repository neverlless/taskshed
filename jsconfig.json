{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "web/static/js/**/*.js",
    "web/types/**/*.d.ts"
  ],
  "exclude": [
    "web/static/vendor"
  ]
}
