package ui

// Layout is the page shell shared by both pages. current is "calendar" or "tasks".
templ Layout(title, current string) {
	<!DOCTYPE html>
	<html
		lang="en"
		if themeFrom(ctx) != "" {
			data-theme={ themeFrom(ctx) }
		}
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"historyCacheSize":0}'/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<link rel="icon" href="/static/images/favicon.ico" type="image/x-icon"/>
			<script type="module" src="/static/js/app.js"></script>
			<script defer src="/static/vendor/htmx/htmx.min.js"></script>
		</head>
		<body>
			<header class="topbar">
				<a class="brand" href="/">TaskShed</a>
				<nav aria-label="Main">
					<a
						href="/"
						if current == "calendar" {
							aria-current="page"
						}
					>Calendar</a>
					<a
						href="/tasks-view"
						if current == "tasks" {
							aria-current="page"
						}
					>Tasks</a>
				</nav>
				// Hidden until app.js wires it up; the server renders the saved choice so there is no flash.
				<div class="theme-switch" role="group" aria-label="Color theme" hidden>
					@themeButton("", "Use system theme") {
						<rect x="2.5" y="3.5" width="15" height="10" rx="1.5"></rect>
						<path d="M7 17h6M10 13.5V17"></path>
					}
					@themeButton("light", "Use light theme") {
						<circle cx="10" cy="10" r="3.5"></circle>
						<path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4"></path>
					}
					@themeButton("dark", "Use dark theme") {
						<path d="M16 12.5A6.5 6.5 0 0 1 7.5 4a6.5 6.5 0 1 0 8.5 8.5z"></path>
					}
				</div>
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

// PageHead is the page title with the viewer's time zone, filled in by app.js.
templ PageHead(title string) {
	<div class="page-head">
		<h1>{ title }</h1>
		<p class="tz" id="tz"></p>
	</div>
}

// Message is the empty, error and no-match state. The link is optional.
templ Message(title, detail, linkText, linkHref string) {
	<div class="message" role="status">
		<p class="message-title">{ title }</p>
		if detail != "" {
			<p>{ detail }</p>
		}
		if linkText != "" {
			<a class="button" href={ templ.URL(linkHref) }>{ linkText }</a>
		}
	</div>
}

templ themeButton(value, label string) {
	<button
		type="button"
		data-theme-value={ value }
		aria-label={ label }
		title={ label }
		if themeFrom(ctx) == value {
			aria-pressed="true"
		} else {
			aria-pressed="false"
		}
	>
		<svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			{ children... }
		</svg>
	</button>
}
